// ── Submit Handler ──

document.addEventListener('submit', function(e) {
  var form = e.target;
  if (!form.classList.contains('ajax-form') && !form.classList.contains('ajax-upload')) return;
  e.preventDefault();
  var confirmMsg = form.getAttribute('data-confirm');
  if (confirmMsg && !confirm(confirmMsg)) return;
  var btn = form.querySelector('button[type="submit"]');
  var sp = btn ? spinner(btn) : null;
  var action = form.getAttribute('action');
  var method = form.getAttribute('method') || 'POST';
  var useUpload = form.classList.contains('ajax-upload');
  var body = useUpload ? new FormData(form) : JSON.stringify(function(f) {
    var data = {}, fd = new FormData(f);
    fd.forEach(function(v, k) { data[k] = v; });
    return data;
  }(form));
  var headers = useUpload ? {} : { 'Content-Type': 'application/json' };
  fetch(action, { method: method, headers: headers, body: body }).then(function(r) {
    return r.json().catch(function() { return {}; });
  }).then(function(data) {
    if (sp) sp.restore();
    if (data.error) { return showToast(data.error, 'error'); }
    if (!data.success) { return showToast(data.msg || 'Done!', 'success'); }
    showToast(data.msg || 'Done!', 'success');
    // ── Route responses ──
    // ── Person rename ──
    if (action.indexOf('/rename') > 0 && action.indexOf('/playlist/rename') < 0) {
      var personId = action.match(/\/person\/([^/]+)\/rename/)[1];
      var section = closest(form, '[data-person-id]');
      if (section) qs('.person-name', section).textContent = data.name;
    }
    // ── Delete person ──
    else if (action.match(/\/person\/[^/]+\/delete$/)) {
      var section = closest(form, '.admin-person');
      if (section) section.remove();
    }
    // ── Delete item ──
    else if (action.indexOf('/item/delete') > 0) {
      var row = closest(form, '[data-filename]');
      if (row) {
        var tbody = closest(row, 'tbody');
        row.remove();
        var itemsBox = closest(form, '.section-items');
        if (itemsBox) {
          var rows = qsa('tr[data-filename]', itemsBox);
          var countH = qs('.items-count', itemsBox);
          if (countH) countH.textContent = 'Items (' + rows.length + ')';
          if (rows.length === 0) {
            var list = qs('.items-list', itemsBox);
            if (list) list.remove();
            itemsBox.innerHTML = '<p class="empty-note">No items in this section.</p>';
          }
        }
      }
    }
    // ── Delete milestone ──
    else if (action.indexOf('/roadmap/delete') > 0) {
      var row = closest(form, '[data-idx]');
      if (row) {
        var tbody = closest(row, 'tbody');
        row.remove();
        var rmItems = closest(form, '.roadmap-items');
        var rows = qsa('tr', tbody);
        qsa('tr', tbody).forEach(function(r, i) {
          r.setAttribute('data-idx', i);
          var input = qs('input[name="index"]', r);
          if (input) input.value = i;
        });
        var h4 = qs('.items-list h4', rmItems);
        if (h4) h4.textContent = 'Milestones (' + rows.length + ')';
        if (rows.length === 0) {
          var list = qs('.items-list', rmItems);
          if (list) list.remove();
          rmItems.innerHTML = '<p class="empty-note">No milestones yet.</p>';
        }
      }
    }
    // ── Delete song ──
    else if (action.indexOf('/playlist/delete') > 0) {
      var row = closest(form, '[data-idx]');
      if (row) {
        var tbody = closest(row, 'tbody');
        row.remove();
        qsa('tr', tbody).forEach(function(r, i) {
