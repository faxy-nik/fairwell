<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin - Class Memories</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="admin-page">
  <div class="container" id="admin-app">
    <div class="toast-container" id="toast-container"></div>

    <header class="admin-header">
      <h1>Admin Panel</h1>
      <nav>
        <a href="/" target="_blank">View Public Page</a>
        <a href="/admin/logout">Logout</a>
      </nav>
    </header>

    <section class="admin-section">
      <button class="admin-collapse-toggle" onclick="toggleCollapse(this)">
        <h2 style="margin:0;font-size:1.1rem">&#9881; Settings</h2>
        <span class="collapse-icon">&#9660;</span>
      </button>
      <div class="admin-collapse-content">
        <form class="inline-form ajax-form" action="/admin/change-password" style="margin-top:12px">
          <input type="password" name="currentPassword" placeholder="Current password" required>
          <input type="password" name="newPassword" placeholder="New password" required>
          <button type="submit" class="btn small">Change Password</button>
        </form>
        <div style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap">
          <a href="/admin/download-config" class="btn small" style="text-decoration:none" download>&#128190; Download Backup</a>
          <form class="ajax-form inline-form" action="/admin/upload-config" style="gap:4px" id="restore-form">
            <input type="file" accept=".json" style="font-size:0.8rem;color:#ccc" id="restore-file-input" required>
            <input type="hidden" name="config" id="restore-config-input">
            <button type="submit" class="btn small">&#128194; Restore Backup</button>
          </form>
          <script>
            document.getElementById('restore-file-input').addEventListener('change', function() {
              if (this.files[0]) {
                var r = new FileReader();
                r.onload = function() { document.getElementById('restore-config-input').value = r.result; };
                r.readAsText(this.files[0]);
              }
            });
          </script>
          </div>
        </div>
      </div>
    </section>

    <section class="admin-section">
      <button class="admin-collapse-toggle" onclick="toggleCollapse(this)">
        <h2 style="margin:0;font-size:1.1rem">&#128279; General Roadmap URLs</h2>
        <span class="collapse-icon">&#9660;</span>
      </button>
      <div class="admin-collapse-content">
        <p class="empty-note">Paste resource links for the 7-week plan and 9 AI skills.</p>
        <form class="ajax-form" action="/api/general-urls">
          <div class="urls-grid">
            <div class="url-group">
              <h4>7-Week Plan</h4>
              <% var weekLabels = {week1:'Week 1 — Python Basics',week2:'Week 2 — AI APIs',week3:'Week 3 — Vibe Coding',week4:'Week 4 — Build a Project',week5:'Week 5 — HTML/CSS + v0.dev',week6:'Week 6 — Deploy Live',week7:'Week 7 — Polish & Portfolio'}; %>
              <% Object.keys(weekLabels).forEach(function(k) { %>
                <label><%= weekLabels[k] %><input type="url" name="<%= k %>" value="<%= generalUrls[k] || '' %>" placeholder="https://..."></label>
              <% }); %>
            </div>
            <div class="url-group">
              <h4>9 AI Skills</h4>
              <% var skillLabels = {skill1:'Prompt Engineering',skill2:'AI Workflow Automation',skill3:'AI Agents',skill4:'RAG',skill5:'Fine-Tuning & GPTs',skill6:'Multimodal AI',skill7:'AI Video Generation',skill8:'AI Tool Stacking',skill9:'LLM Evaluation'}; %>
              <% Object.keys(skillLabels).forEach(function(k) { %>
                <label><%= skillLabels[k] %><input type="url" name="<%= k %>" value="<%= generalUrls[k] || '' %>" placeholder="https://..."></label>
              <% }); %>
            </div>
          </div>
          <button type="submit" class="btn">Save URLs</button>
        </form>
      </div>
    </section>

    <section class="admin-section" id="add-person-form">
      <h2 style="font-size:1.1rem;margin-bottom:12px">&#10133; Add Person</h2>
      <form class="inline-form ajax-form" action="/api/person">
        <input type="text" name="name" placeholder="Person name" required>
        <button type="submit" class="btn">Add</button>
      </form>
    </section>

    <% people.forEach(function(person) { %>
      <section class="admin-person" data-person-id="<%= person.id %>">
        <div class="person-head" style="margin-bottom:0">
          <button class="admin-collapse-toggle" onclick="toggleCollapse(this)">
            <h2 class="person-name" style="font-size:1.2rem;margin:0"><%= person.name %></h2>
            <span class="collapse-icon">&#9660;</span>
          </button>
          <div class="person-actions">
            <form class="inline-form ajax-form" action="/api/person/<%= person.id %>/rename" style="gap:4px">
              <input type="text" name="name" placeholder="Rename" required>
              <button type="submit" class="btn small">Rename</button>
            </form>
            <form class="ajax-form" action="/api/person/<%= person.id %>/delete" data-confirm="Delete this person and all their content?">
              <button type="submit" class="btn small danger">Delete</button>
            </form>
          </div>
        </div>

        <div class="admin-collapse-content">
          <div class="access-link" style="margin-top:12px">
            <strong>Access Link:</strong>
            <input type="text" value="<%= publicUrl %>/p/<%= person.accessToken %>" readonly onclick="this.select()" class="link-input">
            <button class="btn small" onclick="var i=this.previousElementSibling;navigator.clipboard.writeText(i.value);showToast('Copied!','success')">Copy</button>
          </div>

          <div class="theme-form" style="margin:10px 0;padding:10px;background:#0f1a2e;border-radius:8px">
            <form class="inline-form ajax-form" action="/api/person/<%= person.id %>/theme" style="flex-wrap:wrap">
              <input type="color" name="theme" value="<%= person.theme || '#667eea' %>" style="width:40px;height:36px;padding:2px;border:1px solid #2a3a5e;border-radius:6px;background:transparent;cursor:pointer">
              <input type="text" name="badge" placeholder="Badge (e.g. The Poet)" value="<%= person.badge || '' %>" style="flex:1;min-width:120px">
              <input type="text" name="customMessage" placeholder="Private message for them" value="<%= person.customMessage || '' %>" style="flex:2;min-width:180px">
              <button type="submit" class="btn small">Save</button>
            </form>
            <form class="inline-form ajax-form" action="/api/person/<%= person.id %>/metdate" style="margin-top:8px;flex-wrap:wrap">
              <label style="color:#94a3b8;font-size:0.8rem;display:flex;align-items:center;gap:6px">📅 We Met On:
                <input type="date" name="metDate" value="<%= person.metDate || '' %>" style="padding:4px 8px;border:1px solid #2a3a5e;border-radius:6px;background:#0a1628;color:#e2e8f0;font-size:0.8rem">
              </label>
              <button type="submit" class="btn small">Set Date</button>
            </form>
          </div>

          <div class="add-section">
            <h3>Add Section to <%= person.name %></h3>
            <form class="inline-form ajax-form" action="/api/person/<%= person.id %>/section">
              <input type="text" name="title" placeholder="Section title" required>
              <select name="type">
                <option value="images">Images</option>
                <option value="voice">Voice</option>
                <option value="videos">Videos</option>
                <option value="texts">Texts</option>
                <option value="other">Other</option>
              </select>
              <button type="submit" class="btn small">Add</button>
            </form>
          </div>

          <div class="admin-section-box roadmap-box">
            <div class="section-head">
              <h3>Roadmap</h3>
            </div>
            <div class="upload-form">
              <h4>Add Milestone</h4>
              <form class="ajax-form upload-form-inner" action="/api/person/<%= person.id %>/roadmap/add">
                <input type="text" name="title" placeholder="Milestone title" required>
                <input type="date" name="date">
                <input type="text" name="description" placeholder="Description">
                <button type="submit" class="btn small">Add</button>
              </form>
            </div>
            <div class="roadmap-items">
              <% if (person.roadmap && person.roadmap.length > 0) { %>
                <div class="items-list">
                  <h4>Milestones (<%= person.roadmap.length %>)</h4>
                  <table>
                    <thead>
                      <tr><th>Date</th><th>Title</th><th>Description</th><th>Action</th></tr>
                    </thead>
                    <tbody>
                      <% person.roadmap.forEach(function(item, idx) { %>
                        <tr data-idx="<%= idx %>">
                          <td><%= item.date %></td>
                          <td><%= item.title %></td>
                          <td><%= item.description %></td>
                          <td>
                            <form class="ajax-form inline-form" action="/api/person/<%= person.id %>/roadmap/delete" data-confirm="Delete this milestone?">
                              <input type="hidden" name="index" value="<%= idx %>">
                              <button type="submit" class="btn small danger">Delete</button>
                            </form>
                          </td>
                        </tr>
                      <% }); %>
                    </tbody>
                  </table>
                </div>
              <% } else { %>
                <p class="empty-note">No milestones yet.</p>
              <% } %>
            </div>
          </div>

          <div class="admin-section-box playlist-box">
            <div class="section-head">
              <h3>Playlist</h3>
            </div>
            <div class="upload-form">
              <form class="ajax-form upload-form-inner" action="/api/person/<%= person.id %>/playlist/add">
                <input type="text" name="title" placeholder="Song title" required>
                <input type="url" name="url" placeholder="https://youtube.com/..." required>
                <button type="submit" class="btn small">Add Song</button>
              </form>
            </div>
            <div class="playlist-items">
              <% if (person.playlist && person.playlist.length > 0) { %>
                <div class="items-list">
                  <table>
                    <thead><tr><th>Title</th><th>URL</th><th>Action</th></tr></thead>
                    <tbody>
                      <% person.playlist.forEach(function(song, idx) { %>
                        <tr data-idx="<%= idx %>">
                          <td>
                            <form class="ajax-form inline-form" action="/api/person/<%= person.id %>/playlist/rename" style="gap:4px;flex-wrap:nowrap">
                              <input type="hidden" name="index" value="<%= idx %>">
                              <input type="text" name="title" value="<%= song.title %>" style="padding:4px 6px;font-size:0.75rem;width:120px">
                              <button type="submit" class="btn small" style="padding:4px 8px;font-size:0.7rem">Save</button>
                            </form>
                          </td>
                          <td><a href="<%= song.url %>" target="_blank" style="color:#667eea;font-size:0.8rem"><%= song.url.length > 40 ? song.url.substring(0,40)+'...' : song.url %></a></td>
                          <td>
                            <form class="ajax-form" action="/api/person/<%= person.id %>/playlist/delete" data-confirm="Remove this song?">
                              <input type="hidden" name="index" value="<%= idx %>">
                              <button type="submit" class="btn small danger">Delete</button>
                            </form>
                          </td>
                        </tr>
                      <% }); %>
                    </tbody>
                  </table>
                </div>
              <% } else { %>
                <p class="empty-note">No songs yet.</p>
              <% } %>
          </div>
        </div>

          <div class="admin-section-box" style="margin-top:10px">
            <div class="section-head"><h3>Reasons</h3></div>
            <div class="upload-form">
              <form class="ajax-form upload-form-inner" action="/api/person/<%= person.id %>/reason/add">
                <input type="text" name="reason" placeholder="Why they're special..." required>
                <button type="submit" class="btn small">Add</button>
              </form>
            </div>
            <div class="reason-items">
              <% if (person.reasons && person.reasons.length > 0) { %>
                <div class="items-list"><h4>Reasons (<%= person.reasons.length %>)</h4>
                  <table><thead><tr><th>Reason</th><th>Action</th></tr></thead><tbody>
                    <% person.reasons.forEach(function(r, idx) { %>
                      <tr data-reason-idx="<%= idx %>">
                        <td><%= r %></td>
                        <td><form class="ajax-form" action="/api/person/<%= person.id %>/reason/delete" data-confirm="Delete this reason?"><input type="hidden" name="index" value="<%= idx %>"><button type="submit" class="btn small danger">Delete</button></form></td>
                      </tr>
                    <% }); %>
                  </tbody></table>
                </div>
              <% } else { %><p class="empty-note">No reasons yet.</p><% } %>
            </div>
          </div>

          <div class="admin-section-box" style="margin-top:10px">
            <div class="section-head"><h3>Compliments</h3></div>
            <div class="upload-form">
              <form class="ajax-form upload-form-inner" action="/api/person/<%= person.id %>/compliment/add">
                <input type="text" name="compliment" placeholder="A sweet compliment..." required>
                <button type="submit" class="btn small">Add</button>
              </form>
            </div>
            <div class="compliment-items">
              <% if (person.compliments && person.compliments.length > 0) { %>
                <div class="items-list"><h4>Compliments (<%= person.compliments.length %>)</h4>
                  <table><thead><tr><th>Compliment</th><th>Action</th></tr></thead><tbody>
                    <% person.compliments.forEach(function(c, idx) { %>
                      <tr data-compliment-idx="<%= idx %>">
                        <td><%= c %></td>
                        <td><form class="ajax-form" action="/api/person/<%= person.id %>/compliment/delete" data-confirm="Delete this compliment?"><input type="hidden" name="index" value="<%= idx %>"><button type="submit" class="btn small danger">Delete</button></form></td>
                      </tr>
                    <% }); %>
                  </tbody></table>
                </div>
              <% } else { %><p class="empty-note">No compliments yet.</p><% } %>
            </div>
          </div>

          <div class="admin-section-box" style="margin-top:10px">
            <div class="section-head"><h3>Quiz</h3></div>
            <div class="upload-form">
              <form class="ajax-form upload-form-inner" action="/api/person/<%= person.id %>/quiz/add">
                <input type="text" name="question" placeholder="Question" required style="width:100%;box-sizing:border-box;margin-bottom:6px">
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:4px">
                  <input type="text" name="options" placeholder='["Option A","Option B","Option C","Option D"]' required style="grid-column:span 2;font-size:0.75rem;color:#94a3b8">
                </div>
                <div style="display:flex;gap:6px;align-items:center;margin-top:4px">
                  <label style="color:#94a3b8;font-size:0.75rem">Correct Answer (0-based index):
                    <input type="number" name="answer" min="0" max="3" value="0" required style="width:50px;padding:4px;font-size:0.75rem">
                  </label>
                  <button type="submit" class="btn small">Add</button>
                </div>
              </form>
            </div>
            <div class="quiz-items">
              <% if (person.quiz && person.quiz.length > 0) { %>
                <div class="items-list"><h4>Questions (<%= person.quiz.length %>)</h4>
                  <table><thead><tr><th>Question</th><th>Options</th><th>Answer</th><th>Action</th></tr></thead><tbody>
                    <% person.quiz.forEach(function(q, idx) { %>
                      <tr data-quiz-idx="<%= idx %>">
                        <td style="font-size:0.8rem"><%= q.question %></td>
                        <td style="font-size:0.75rem;color:#94a3b8"><%= JSON.stringify(q.options) %></td>
                        <td style="font-size:0.8rem"><%= q.answer %></td>
                        <td><form class="ajax-form" action="/api/person/<%= person.id %>/quiz/delete" data-confirm="Delete this question?"><input type="hidden" name="index" value="<%= idx %>"><button type="submit" class="btn small danger">Delete</button></form></td>
                      </tr>
                    <% }); %>
                  </tbody></table>
                </div>
              <% } else { %><p class="empty-note">No quiz questions yet.</p><% } %>
            </div>
          </div>

          <% person.sections.forEach(function(section) { %>
            <div class="admin-section-box" id="section-<%= person.id %>-<%= section.id %>" data-section-id="<%= section.id %>">
              <div class="section-head">
                <h3><%= section.title %> <span class="badge"><%= section.type %></span></h3>
                <form class="ajax-form" action="/api/person/<%= person.id %>/section/<%= section.id %>/delete" data-confirm="Delete this section and all its files?">
                  <button type="submit" class="btn small danger">Delete Section</button>
                </form>
              </div>

              <div class="upload-form">
                <h4>Upload to <%= section.title %></h4>
                <form class="upload-form-inner ajax-upload" action="/api/upload" enctype="multipart/form-data">
                  <input type="hidden" name="personId" value="<%= person.id %>">
                  <input type="hidden" name="sectionId" value="<%= section.id %>">
                  <input type="file" name="file" required>
                  <input type="text" name="title" placeholder="Display title (optional)">
                  <label>
                    Release Date:
                    <input type="date" name="releaseDate" value="<%= new Date().toISOString().split('T')[0] %>">
                  </label>
                  <button type="submit" class="btn small">Upload</button>
                </form>

                <% if (section.type === 'voice') { %>
                  <div class="voice-recorder" style="margin-top:10px;padding:12px;border:1px dashed #555;border-radius:8px">
                    <h4>&#127908; Record Voice Note</h4>
                    <button type="button" class="btn small" onclick="startRecording(this)" data-person="<%= person.id %>" data-section="<%= section.id %>">Start Recording</button>
                    <span class="rec-status"></span>
                    <input type="text" id="rec-title-<%= section.id %>" placeholder="Voice title" style="width:100%;margin-top:6px;box-sizing:border-box">
                    <audio id="rec-preview-<%= section.id %>" controls style="display:none;width:100%;margin-top:6px"></audio>
                    <button type="button" class="btn small" id="rec-upload-<%= section.id %>" style="display:none;margin-top:6px" onclick="uploadRecording('<%= person.id %>','<%= section.id %>')">Upload Recording</button>
                  </div>
                <% } %>

                <div class="section-items">
                  <% if (section.items.length > 0) { %>
                    <div class="items-list">
                      <h4 class="items-count">Items (<%= section.items.length %>)</h4>
                      <table>
                        <thead>
                          <tr><th>Title</th><th>File</th><th>Release Date</th><th>Action</th></tr>
                        </thead>
                        <tbody>
                          <% section.items.forEach(function(item) { %>
                            <tr data-filename="<%= item.filename %>">
                              <td class="item-title"><%= item.title %></td>
                              <td class="item-name"><%= item.originalName %></td>
                              <td>
                                <form class="ajax-form inline-form" action="/api/person/<%= person.id %>/section/<%= section.id %>/item/date" style="gap:4px;flex-wrap:nowrap">
                                  <input type="hidden" name="filename" value="<%= item.filename %>">
                                  <input type="date" name="releaseDate" value="<%= new Date(item.releaseDate).toISOString().split('T')[0] %>" style="padding:4px 6px;font-size:0.75rem;width:130px">
                                  <button type="submit" class="btn small" style="padding:4px 8px;font-size:0.7rem">Save</button>
                                </form>
                              </td>
                              <td>
                                <form class="ajax-form" action="/api/person/<%= person.id %>/section/<%= section.id %>/item/delete" data-confirm="Delete this item?">
                                  <input type="hidden" name="filename" value="<%= item.filename %>">
                                  <button type="submit" class="btn small danger">Delete</button>
                                </form>
                              </td>
                            </tr>
                          <% }); %>
                        </tbody>
                      </table>
                    </div>
                  <% } else { %>
                    <p class="empty-note">No items in this section.</p>
                  <% } %>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      </section>
    <% }); %>
  </div>

<script>
var mediaRecorder, audioChunks = [], recordingPersonId, recordingSectionId;

// ── Helpers ──

function showToast(msg, type) {
  type = type || 'success';
  var c = document.getElementById('toast-container');
  var t = document.createElement('div');
  t.className = 'toast ' + type;
  t.textContent = msg;
  c.appendChild(t);
  setTimeout(function() { if (t.parentNode) t.parentNode.removeChild(t); }, 3000);
}

function toggleCollapse(btn) {
  btn.classList.toggle('collapsed');
  var section = closest(btn, '.admin-person, .admin-section');
  var content = section ? section.querySelector('.admin-collapse-content') : null;
  if (content) content.classList.toggle('closed');
}

function esc(str) {
  return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function qs(sel, ctx) { return (ctx || document).querySelector(sel); }
function qsa(sel, ctx) { return (ctx || document).querySelectorAll(sel); }

function closest(el, sel) {
  while (el) { if (el.matches && el.matches(sel)) return el; el = el.parentElement; }
  return null;
}

function spinner(btn) {
  btn.disabled = true;
  var orig = btn.innerHTML;
  btn.innerHTML = '<span class="admin-spinner"></span>';
  return { restore: function() { btn.disabled = false; btn.innerHTML = orig; } };
}

// ── DOM Builders ──

function itemRow(personId, sectionId, filename, originalName, title, releaseDate) {
  var d = releaseDate ? releaseDate.split('T')[0] : new Date().toISOString().split('T')[0];
  return '<tr data-filename="' + esc(filename) + '">' +
    '<td class="item-title">' + esc(title) + '</td>' +
    '<td class="item-name">' + esc(originalName) + '</td>' +
    '<td>' +
      '<form class="ajax-form inline-form" action="/api/person/' + esc(personId) + '/section/' + esc(sectionId) + '/item/date" style="gap:4px;flex-wrap:nowrap">' +
        '<input type="hidden" name="filename" value="' + esc(filename) + '">' +
        '<input type="date" name="releaseDate" value="' + d + '" style="padding:4px 6px;font-size:0.75rem;width:130px">' +
        '<button type="submit" class="btn small" style="padding:4px 8px;font-size:0.7rem">Save</button>' +
      '</form>' +
    '</td>' +
    '<td>' +
      '<form class="ajax-form" action="/api/person/' + esc(personId) + '/section/' + esc(sectionId) + '/item/delete" data-confirm="Delete this item?">' +
        '<input type="hidden" name="filename" value="' + esc(filename) + '">' +
        '<button type="submit" class="btn small danger">Delete</button>' +
      '</form>' +
    '</td></tr>';
}

function milestoneRow(personId, title, date, desc, idx) {
  return '<tr data-idx="' + idx + '">' +
    '<td>' + esc(date) + '</td>' +
    '<td>' + esc(title) + '</td>' +
    '<td>' + esc(desc) + '</td>' +
    '<td>' +
      '<form class="ajax-form inline-form" action="/api/person/' + esc(personId) + '/roadmap/delete" data-confirm="Delete this milestone?">' +
        '<input type="hidden" name="index" value="' + idx + '">' +
        '<button type="submit" class="btn small danger">Delete</button>' +
      '</form>' +
    '</td></tr>';
}

function songRow(personId, title, url, idx) {
  return '<tr data-idx="' + idx + '">' +
    '<td>' +
      '<form class="ajax-form inline-form" action="/api/person/' + esc(personId) + '/playlist/rename" style="gap:4px;flex-wrap:nowrap">' +
        '<input type="hidden" name="index" value="' + idx + '">' +
        '<input type="text" name="title" value="' + esc(title) + '" style="padding:4px 6px;font-size:0.75rem;width:120px">' +
        '<button type="submit" class="btn small" style="padding:4px 8px;font-size:0.7rem">Save</button>' +
      '</form>' +
    '</td>' +
    '<td><a href="' + esc(url) + '" target="_blank" style="color:#667eea;font-size:0.8rem">' + (url.length > 40 ? esc(url.substring(0,40)) + '...' : esc(url)) + '</a></td>' +
    '<td>' +
      '<form class="ajax-form" action="/api/person/' + esc(personId) + '/playlist/delete" data-confirm="Remove this song?">' +
