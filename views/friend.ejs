  <!-- ── Sky Generator ── -->
  <script>
  (function() {
    var canvas = document.getElementById('sky-canvas');
    if (!canvas) return;
    var types = ['morning','rain','night','sunset','storm','snow','aurora','fog'];
    var sky = types[Math.floor(Math.random() * types.length)];
    canvas.className = 'sky-canvas sky-' + sky;
    var label = document.getElementById('sky-label');
    if (label) label.textContent = '\u2601\ufe0f ' + sky.charAt(0).toUpperCase() + sky.slice(1) + '. ';

    function el(tag, cls, parent) {
      var e = document.createElement(tag);
      if (cls) e.className = cls;
      if (parent) parent.appendChild(e);
      return e;
    }

    if (sky === 'morning') {
      canvas.style.background = 'linear-gradient(180deg, #fdd89b 0%, #f9a825 40%, #ff8f00 70%, #ff6f00 100%)';
      var sun = el('div','sky-sun',canvas);
      sun.style.cssText = 'position:absolute;top:18%;right:22%;width:70px;height:70px;border-radius:50%;background:radial-gradient(circle,#fff9c4,#ffd54f);box-shadow:0 0 60px rgba(255,213,79,0.6);animation:skyPulse 3s ease-in-out infinite';
      for (var i=0;i<4;i++) {
        var c = el('div','sky-cloud',canvas);
        var s = 40 + Math.random()*60;
        c.style.cssText = 'position:absolute;top:'+(8+Math.random()*25)+'%;left:'+(-10+Math.random()*80)+'%;width:'+s+'px;height:'+(s*0.5)+'px;border-radius:50px;background:rgba(255,255,255,'+(0.3+Math.random()*0.2)+');animation:skyDrift '+(12+Math.random()*10)+'s linear infinite;opacity:0.6';
      }
    }
    else if (sky === 'rain') {
      canvas.style.background = 'linear-gradient(180deg, #4a5568 0%, #2d3748 40%, #1a202c 100%)';
      for (var i=0;i<60;i++) {
        var d = el('div','sky-drop',canvas);
        var left = Math.random()*100;
        var delay = Math.random()*2;
        var dur = 0.5 + Math.random()*0.4;
        d.style.cssText = 'position:absolute;top:-10px;left:'+left+'%;width:1.5px;height:'+(12+Math.random()*18)+'px;background:rgba(180,200,255,'+(0.2+Math.random()*0.3)+');animation:skyRain ' + dur + 's linear ' + delay + 's infinite';
      }
      for (var i=0;i<3;i++) {
        var c = el('div','sky-cloud',canvas);
        var s = 80 + Math.random()*100;
        c.style.cssText = 'position:absolute;top:'+(2+Math.random()*12)+'%;left:'+(-5+Math.random()*70)+'%;width:'+s+'px;height:'+(s*0.45)+'px;border-radius:50px;background:rgba(60,70,90,0.7);animation:skyDrift '+(18+Math.random()*12)+'s linear infinite;opacity:0.8';
      }
    }
    else if (sky === 'night') {
      canvas.style.background = 'linear-gradient(180deg, #0b0e1a 0%, #141b33 40%, #1a2456 100%)';
      for (var i=0;i<50;i++) {
        var st = el('div','sky-star',canvas);
        var size = 1 + Math.random()*2.5;
        var delay = Math.random()*4;
        st.style.cssText = 'position:absolute;top:'+(Math.random()*60)+'%;left:'+(Math.random()*100)+'%;width:'+size+'px;height:'+size+'px;border-radius:50%;background:#fff;animation:skyTwinkle '+(2+Math.random()*3)+'s ease-in-out '+delay+'s infinite;opacity:'+(0.3+Math.random()*0.5);
      }
      var moon = el('div','sky-moon',canvas);
      moon.style.cssText = 'position:absolute;top:14%;left:65%;width:60px;height:60px;border-radius:50%;background:radial-gradient(circle at 40% 40%,#fffde7,#fff9c4);box-shadow:0 0 80px rgba(255,249,196,0.25);opacity:0.85';
      var moonC = el('div','sky-moon-crater',moon);
      moonC.style.cssText = 'position:absolute;top:25%;left:55%;width:14px;height:14px;border-radius:50%;background:rgba(200,190,160,0.2)';
      var moonC2 = el('div','sky-moon-crater',moon);
      moonC2.style.cssText = 'position:absolute;top:55%;left:25%;width:8px;height:8px;border-radius:50%;background:rgba(200,190,160,0.15)';
    }
    else if (sky === 'sunset') {
      canvas.style.background = 'linear-gradient(180deg, #1a0533 0%, #4a1942 20%, #c0392b 45%, #e67e22 65%, #f39c12 80%, #f1c40f 100%)';
      var sun = el('div','sky-sunset-sun',canvas);
      sun.style.cssText = 'position:absolute;bottom:20%;left:50%;transform:translateX(-50%);width:100px;height:100px;border-radius:50%;background:radial-gradient(circle,#ffe082,#ff8f00);box-shadow:0 0 100px rgba(255,143,0,0.5);opacity:0.9';
      var horizon = el('div','sky-horizon',canvas);
      horizon.style.cssText = 'position:absolute;bottom:0;left:0;right:0;height:18%;background:#1a0a12;border-radius:50% 50% 0 0 / 100% 100% 0 0;opacity:0.6';
      for (var i=0;i<3;i++) {
        var c = el('div','sky-sunset-cloud',canvas);
        var s = 50 + Math.random()*70;
        c.style.cssText = 'position:absolute;top:'+(8+Math.random()*18)+'%;left:'+(-5+Math.random()*70)+'%;width:'+s+'px;height:'+(s*0.4)+'px;border-radius:50px;background:rgba(200,100,60,'+(0.15+Math.random()*0.15)+');animation:skyDrift '+(15+Math.random()*10)+'s linear infinite';
      }
    }
    else if (sky === 'storm') {
      canvas.style.background = 'linear-gradient(180deg, #1a1a2e 0%, #16213e 30%, #0f3460 60%, #1a1a2e 100%)';
      for (var i=0;i<80;i++) {
        var d = el('div','sky-storm-rain',canvas);
        d.style.cssText = 'position:absolute;top:-10px;left:'+(Math.random()*100)+'%;width:1.5px;height:'+(15+Math.random()*25)+'px;background:rgba(150,180,220,'+(0.15+Math.random()*0.2)+');animation:skyRain '+(0.3+Math.random()*0.3)+'s linear '+(Math.random()*2)+'s infinite';
      }
      for (var i=0;i<3;i++) {
        var c = el('div','sky-storm-cloud',canvas);
        var s = 100 + Math.random()*120;
        c.style.cssText = 'position:absolute;top:'+(2+Math.random()*10)+'%;left:'+(-10+Math.random()*60)+'%;width:'+s+'px;height:'+(s*0.5)+'px;border-radius:50px;background:rgba(30,35,50,0.8);animation:skyDrift '+(20+Math.random()*15)+'s linear infinite;opacity:0.9';
      }
      setInterval(function() {
        if (Math.random() > 0.6) {
          canvas.style.transition = 'background 0.1s';
          canvas.style.background = 'linear-gradient(180deg, #2a2a4e 0%, #263158 30%, #1f4070 60%, #2a2a4e 100%)';
          setTimeout(function() {
            canvas.style.background = 'linear-gradient(180deg, #1a1a2e 0%, #16213e 30%, #0f3460 60%, #1a1a2e 100%)';
          }, 100);
        }
      }, 3000);
    }
    else if (sky === 'snow') {
      canvas.style.background = 'linear-gradient(180deg, #1a1a2e 0%, #2d3a4a 30%, #3d5a6d 60%, #4a6a7a 100%)';
      for (var i=0;i<80;i++) {
        var flake = el('div','sky-snowflake',canvas);
        var size = 2 + Math.random()*4;
        var left = Math.random()*100;
        var delay = Math.random()*5;
        var dur = 3 + Math.random()*4;
        flake.style.cssText = 'position:absolute;top:-10px;left:'+left+'%;width:'+size+'px;height:'+size+'px;border-radius:50%;background:rgba(220,235,255,'+(0.5+Math.random()*0.3)+');animation:skySnow '+dur+'s linear '+delay+'s infinite;opacity:'+(0.4+Math.random()*0.4);
      }
    }
    else if (sky === 'aurora') {
      canvas.style.background = 'linear-gradient(180deg, #0a0a1a 0%, #0f1525 30%, #1a1f35 100%)';
      for (var i=0;i<5;i++) {
        var band = el('div','sky-aurora-band',canvas);
        var hue = 120 + Math.random()*60;
        var top = 10 + Math.random()*40;
        var dur = 6 + Math.random()*4;
        band.style.cssText = 'position:absolute;top:'+top+'%;left:-10%;width:'+(120+Math.random()*80)+'%;height:'+(8+Math.random()*12)+'px;background:linear-gradient(90deg,transparent,hsla('+hue+',80%,60%,0.4),hsla('+(hue+40)+',80%,50%,0.3),transparent);border-radius:50%;filter:blur(8px);animation:skyAurora '+dur+'s ease-in-out infinite;opacity:'+(0.3+Math.random()*0.3);
      }
      for (var i=0;i<30;i++) {
        var st = el('div','sky-star',canvas);
        var size = 1 + Math.random()*2;
        st.style.cssText = 'position:absolute;top:'+(Math.random()*50)+'%;left:'+(Math.random()*100)+'%;width:'+size+'px;height:'+size+'px;border-radius:50%;background:#fff;animation:skyTwinkle '+(2+Math.random()*3)+'s ease-in-out '+(Math.random()*4)+'s infinite;opacity:'+(0.2+Math.random()*0.4);
      }
    }
    else if (sky === 'fog') {
      canvas.style.background = 'linear-gradient(180deg, #3a4048 0%, #4a5058 30%, #5a6068 60%, #6a7078 100%)';
      for (var i=0;i<6;i++) {
        var mist = el('div','sky-mist',canvas);
        var s = 100 + Math.random()*150;
        var top = 10 + Math.random()*60;
        var dur = 15 + Math.random()*15;
        mist.style.cssText = 'position:absolute;top:'+top+'%;left:'+(-10+Math.random()*20)+'%;width:'+s+'px;height:'+(10+Math.random()*15)+'px;border-radius:50%;background:rgba(180,190,200,'+(0.06+Math.random()*0.06)+');filter:blur(12px);animation:skyDrift '+dur+'s linear infinite;opacity:'+(0.3+Math.random()*0.2);
      }
    }
  })();
  </script>

  <!-- ── Particles ── -->
  <script>
  (function() {
    var container = document.getElementById('particles');
    for (var i = 0; i < 20; i++) {
      var p = document.createElement('div');
      p.className = 'particle';
      p.style.left = Math.random() * 100 + '%';
      p.style.animationDuration = (10 + Math.random() * 20) + 's';
      p.style.animationDelay = Math.random() * 15 + 's';
      p.style.width = p.style.height = (2 + Math.random() * 3) + 'px';
      container.appendChild(p);
    }
  })();
  </script>
</body>
</html>
