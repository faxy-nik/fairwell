    <% if (person.memories && person.memories.length > 0) { %>
    <!-- ── Mini Games ── -->
    <div class="f-section">
      <div class="f-section-header">
        <span class="icon">🎮</span>
        <h2>Play With Me</h2>
      </div>
      <div class="games-nav">
        <button class="game-tab active" onclick="switchGame('cardflip')">🃏 Memory Flip</button>
        <button class="game-tab" onclick="switchGame('ttt')">❌ Tic Tac Toe</button>
      </div>

      <!-- Memory Card Flip -->
      <div class="game-panel active" id="panel-cardflip">
        <div class="card-grid" id="card-grid"></div>
        <p class="mem-score" id="mem-score">Find all the pairs!</p>
        <button class="mem-reset" onclick="initCardFlip()">Restart</button>
      </div>

      <!-- Tic Tac Toe -->
      <div class="game-panel" id="panel-ttt">
        <div class="ttt-board" id="ttt-board"></div>
        <p class="ttt-status" id="ttt-status">Your turn — pick a square!</p>
        <button class="ttt-reset" onclick="initTTT()">Restart</button>
      </div>
    </div>
    <script>
    // ── Game Switcher ──
    function switchGame(id) {
      document.querySelectorAll('.game-tab').forEach(function(t) { t.classList.remove('active'); });
      document.querySelectorAll('.game-panel').forEach(function(p) { p.classList.remove('active'); });
      event.target.classList.add('active');
      document.getElementById('panel-' + id).classList.add('active');
    }

    // ── Memory Card Flip ──
    var cardEmojis = ['🌸','🌙','💫','🦋','🌊','🎵','⭐','🌈'];
    var cardPairs, cardFlipped, cardLocked, cardMatched;
    function initCardFlip() {
      cardPairs = cardEmojis.concat(cardEmojis);
      cardPairs.sort(function() { return Math.random() - 0.5; });
      cardFlipped = null;
      cardLocked = false;
      cardMatched = 0;
      var grid = document.getElementById('card-grid');
      grid.innerHTML = '';
      cardPairs.forEach(function(e, i) {
        var card = document.createElement('div');
        card.className = 'mem-card';
        card.innerHTML = '<div class="mem-card-inner"><div class="mem-card-front">?</div><div class="mem-card-back">' + e + '</div></div>';
        card.addEventListener('click', function() { flipCard(card, i); });
        grid.appendChild(card);
      });
      document.getElementById('mem-score').textContent = 'Find all the pairs!';
    }
    function flipCard(card, idx) {
      if (cardLocked || card.classList.contains('flipped') || card.classList.contains('matched')) return;
      card.classList.add('flipped');
      if (!cardFlipped) { cardFlipped = { card: card, idx: idx, emoji: cardPairs[idx] }; return; }
      cardLocked = true;
      var first = cardFlipped;
      if (first.emoji === cardPairs[idx]) {
        card.classList.add('matched');
        first.card.classList.add('matched');
        cardMatched++;
        document.getElementById('mem-score').textContent = cardMatched + '/' + cardEmojis.length + ' pairs found!';
        if (cardMatched === cardEmojis.length) document.getElementById('mem-score').textContent = 'You won! 🎉';
      } else {
        setTimeout(function() {
          card.classList.remove('flipped');
          first.card.classList.remove('flipped');
        }, 800);
      }
      cardFlipped = null;
      setTimeout(function() { cardLocked = false; }, 900);
    }
    initCardFlip();

    // ── Tic Tac Toe ──
    var tttBoard, tttTurn, tttOver;
    function initTTT() {
      tttBoard = ['','','','','','','','',''];
      tttTurn = 'X';
      tttOver = false;
      var board = document.getElementById('ttt-board');
      board.innerHTML = '';
      for (var i = 0; i < 9; i++) {
        var cell = document.createElement('div');
        cell.className = 'ttt-cell';
        cell.setAttribute('data-i', i);
        cell.addEventListener('click', function() { tttPlay(this); });
        board.appendChild(cell);
      }
      document.getElementById('ttt-status').textContent = 'Your turn — pick a square!';
    }
    function tttPlay(cell) {
      if (tttOver || cell.classList.contains('taken')) return;
      var i = parseInt(cell.getAttribute('data-i'));
      tttBoard[i] = 'X';
      cell.textContent = 'X';
      cell.classList.add('taken');
      if (tttCheck('X')) { document.getElementById('ttt-status').textContent = 'You win! 🎉'; tttOver = true; return; }
      if (tttBoard.every(function(c) { return c !== ''; })) { document.getElementById('ttt-status').textContent = "It's a draw!"; tttOver = true; return; }
      // Bot turn
      setTimeout(function() {
        var empty = [];
        tttBoard.forEach(function(c, j) { if (c === '') empty.push(j); });
        if (!empty.length) return;
        var bi = empty[Math.floor(Math.random() * empty.length)];
        tttBoard[bi] = 'O';
        var botCell = document.querySelector('[data-i="'+bi+'"]');
        botCell.textContent = 'O';
        botCell.classList.add('taken');
        if (tttCheck('O')) { document.getElementById('ttt-status').textContent = 'I win! Better luck next time 😄'; tttOver = true; return; }
        if (tttBoard.every(function(c) { return c !== ''; })) { document.getElementById('ttt-status').textContent = "It's a draw!"; tttOver = true; return; }
        document.getElementById('ttt-status').textContent = 'Your turn — pick a square!';
      }, 400);
      document.getElementById('ttt-status').textContent = 'My turn...';
    }
    function tttCheck(p) {
      var w = [[0,1,2],[3,4,5],[6,7,8],[0,3,6],[1,4,7],[2,5,8],[0,4,8],[2,4,6]];
      return w.some(function(l) { return l.every(function(i) { return tttBoard[i] === p; }); });
    }
    initTTT();
    </script>
    <% } %>

