      if (c) c.textContent = reactions[key] ? reactions[key].count : 0;
    });
    window.toggleReaction = function(btn) {
      var key = btn.getAttribute('data-key');
      var r = JSON.parse(localStorage.getItem('reactions') || '{}');
      if (!r[key]) r[key] = { count: 0, reacted: false };
      r[key].reacted = !r[key].reacted;
      r[key].count += r[key].reacted ? 1 : -1;
      if (r[key].count < 0) r[key].count = 0;
      btn.innerHTML = (r[key].reacted ? '❤️' : '🤍') + ' <span class="reaction-count">' + r[key].count + '</span>';
