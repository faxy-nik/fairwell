      for (var i=0;i<3;i++) {
        var c = el('div','sky-sunset-cloud',canvas);
        var s = 50 + Math.random()*70;
        c.style.cssText = 'position:absolute;top:'+(8+Math.random()*18)+'%;left:'+(-5+Math.random()*70)+'%;width:'+s+'px;height:'+(s*0.4)+'px;border-radius:50px;background:rgba(200,100,60,'+(0.15+Math.random()*0.15)+');animation:skyDrift '+(15+Math.random()*10)+'s linear infinite';
      }
    }
    else if (sky === 'storm') {
      canvas.style.background = 'linear-gradient(180deg, #1a1a2e 0%, #16213e 30%, #0f3460 60%, #1a1a2e 100%)';
      for (var i=0;i<80;i++) {
        var d = el('div','sky-storm-rain',canvas);
        d.style.cssText = 'position:absolute;top:-10px;left:'+(Math.random()*100)+'%;width:1.5px;height:'+(15+Math.random()*25)+'px;background:rgba(150,180,220,'+(0.15+Math.random()*0.2)+');animation:skyRain '+(0.3+Math.random()*0.3)+'s linear '+(Math.random()*2)+'s infinite';
      }
      for (var i=0;i<3;i++) {
        var c = el('div','sky-storm-cloud',canvas);
        var s = 100 + Math.random()*120;
        c.style.cssText = 'position:absolute;top:'+(2+Math.random()*10)+'%;left:'+(-10+Math.random()*60)+'%;width:'+s+'px;height:'+(s*0.5)+'px;border-radius:50px;background:rgba(30,35,50,0.8);animation:skyDrift '+(20+Math.random()*15)+'s linear infinite;opacity:0.9';
      }
      // lightning flashes
      setInterval(function() {
        if (Math.random() > 0.6) {
          canvas.style.transition = 'background 0.1s';
          canvas.style.background = 'linear-gradient(180deg, #2a2a4e 0%, #263158 30%, #1f4070 60%, #2a2a4e 100%)';
          setTimeout(function() {
            canvas.style.background = 'linear-gradient(180deg, #1a1a2e 0%, #16213e 30%, #0f3460 60%, #1a1a2e 100%)';
          }, 100);
        }
      }, 3000);
    }
  })();

  // ─── COUNTDOWN ───
  (function() {
    var el = document.getElementById('countdown');
    if (!el) return;
    var target = new Date('2026-07-05T00:00:00').getTime();
    function tick() {
      var now = new Date().getTime();
      var diff = target - now;
      if (diff <= 0) { location.reload(); return; }
      document.getElementById('cd-days').textContent = Math.floor(diff / (1000*60*60*24));
      document.getElementById('cd-hours').textContent = Math.floor((diff % (1000*60*60*24)) / (1000*60*60));
      document.getElementById('cd-mins').textContent = Math.floor((diff % (1000*60*60)) / (1000*60));
      document.getElementById('cd-secs').textContent = Math.floor((diff % (1000*60)) / 1000);
    }
    tick();
    setInterval(tick, 1000);
  })();

  // ─── TAB SWITCHING ───
  document.querySelectorAll('.tab-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.tab-btn').forEach(function(b) { b.classList.remove('active'); });
      document.querySelectorAll('.tab-content').forEach(function(t) { t.classList.remove('active'); });
      btn.classList.add('active');
      document.getElementById('tab-' + btn.getAttribute('data-tab')).classList.add('active');
    });
  });

  // ─── NAMAZ TRACKER ───
  (function() {
    var STORAGE_KEY = 'namaz-logs-<%= person.id %>';
    var PRAYER_NAMES = ['Fajr', 'Dhuhr', 'Asr', 'Maghrib', 'Isha'];

    function getToday() {
      var d = new Date();
      return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
    }

    function loadLogs() {
      try { return JSON.parse(localStorage.getItem(STORAGE_KEY)) || {}; } catch(e) { return {}; }
    }

    function saveLogs(logs) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(logs));
    }

    function calcStats(logs) {
      var today = getToday();
      var todayLog = logs[today] || {};
      var doneToday = 0;
      PRAYER_NAMES.forEach(function(p) { if (todayLog[p]) doneToday++; });

      var totalPrayers = 0;
      var streak = 0;
      var checkDate = new Date();
      while (true) {
        var key = checkDate.getFullYear() + '-' + String(checkDate.getMonth() + 1).padStart(2, '0') + '-' + String(checkDate.getDate()).padStart(2, '0');
        var dayLog = logs[key];
        var anyDone = false;
        if (dayLog) {
          PRAYER_NAMES.forEach(function(p) { if (dayLog[p]) { totalPrayers++; anyDone = true; } });
        }
        if (anyDone) {
          streak++;
          checkDate.setDate(checkDate.getDate() - 1);
        } else {
          if (key === today) { checkDate.setDate(checkDate.getDate() - 1); continue; }
          break;
        }
      }
      return { doneToday: doneToday, totalPrayers: totalPrayers, streak: streak, todayLog: todayLog };
    }

    function renderWeek(logs) {
      var grid = document.getElementById('week-grid');
      if (!grid) return;
      grid.innerHTML = '';
      for (var i = 6; i >= 0; i--) {
        var d = new Date();
        d.setDate(d.getDate() - i);
        var key = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
        var dayLog = logs[key] || {};
        var count = 0;
        PRAYER_NAMES.forEach(function(p) { if (dayLog[p]) count++; });
        var dayNames = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
        var cell = document.createElement('div');
        cell.className = 'week-day';
        if (key === getToday()) cell.classList.add('week-today');
        var filled = Math.round((count / 5) * 100);
        cell.innerHTML = '<div class="week-day-name">' + dayNames[d.getDay()] + '</div><div class="week-day-bar"><div class="week-day-fill" style="height:' + filled + '%"></div></div><div class="week-day-count">' + count + '/5</div>';
        grid.appendChild(cell);
      }
    }

    function updateUI() {
      var logs = loadLogs();
      var stats = calcStats(logs);
      document.getElementById('today-progress').textContent = Math.round((stats.doneToday / 5) * 100) + '%';
      document.getElementById('streak-count').textContent = stats.streak;
      document.getElementById('total-prayers').textContent = stats.totalPrayers;
      document.querySelectorAll('.prayer-check').forEach(function(btn) {
        if (stats.todayLog[btn.getAttribute('data-prayer')]) btn.classList.add('checked');
        else btn.classList.remove('checked');
      });
      renderWeek(logs);
    }

    function togglePrayer(prayer) {
      var logs = loadLogs();
      var today = getToday();
      if (!logs[today]) logs[today] = { Fajr: false, Dhuhr: false, Asr: false, Maghrib: false, Isha: false };
      logs[today][prayer] = !logs[today][prayer];
      saveLogs(logs);
      updateUI();
    }

    document.querySelectorAll('.prayer-check').forEach(function(btn) {
      btn.addEventListener('click', function() { togglePrayer(this.getAttribute('data-prayer')); });
    });

    updateUI();
  })();
  </script>
</body>
</html>
