<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= person.name %> - Class Memories</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="<%= person.id === 'eeshah' ? 'theme-eeshah' : '' %>">
  <% if (person.id === 'eeshah') { %>
  <div class="stars">
    <span class="star"></span><span class="star"></span><span class="star"></span>
    <span class="star"></span><span class="star"></span><span class="star"></span>
    <span class="star"></span><span class="star"></span><span class="star"></span>
    <span class="star"></span><span class="star"></span><span class="star"></span>
    <span class="star"></span><span class="star"></span><span class="star"></span>
  </div>
  <div class="flowers-container">
    <span class="flower">🌸</span><span class="flower">🌷</span><span class="flower">🌹</span>
    <span class="flower">🌺</span><span class="flower">🌻</span><span class="flower">🌼</span>
    <span class="flower">🌸</span><span class="flower">🌷</span><span class="flower">🌹</span>
    <span class="flower">🌺</span>
  </div>
  <canvas class="fireworks-canvas" id="fireworks-canvas"></canvas>
  <% } %>
  <div class="container" style="<%= person.theme ? '--accent:' + person.theme + ';--accent-glow:' + person.theme + '44' : '' %>">
    <%
      var now = new Date();
      var unlock = person.unlockDate ? new Date(person.unlockDate) : new Date('2026-07-05T00:00:00');
      var locked = now < unlock;
      var showGeneral = person.id !== 'muaaz' && person.id !== 'moazam';
      var gu = typeof generalUrls !== 'undefined' ? generalUrls : {};
    %>

    <% if (locked) { %>
      <div class="locked-page">
        <div class="lock-icon-large">🔒</div>
        <h2>Nothing opened yet</h2>
        <p class="locked-sub">We're putting the final touches on everything for you ✨</p>
        <div class="countdown" id="countdown">
          <div class="countdown-item"><span id="cd-days">0</span><span class="cd-label">Days</span></div>
          <div class="countdown-item"><span id="cd-hours">0</span><span class="cd-label">Hours</span></div>
          <div class="countdown-item"><span id="cd-mins">0</span><span class="cd-label">Mins</span></div>
          <div class="countdown-item"><span id="cd-secs">0</span><span class="cd-label">Secs</span></div>
        </div>
        <p class="locked-cta">Come back on <strong>5th July</strong> 🎉</p>
      </div>
    <% } else { %>

    <header class="site-header animate-fade-down">
      <div class="profile-avatar"><%= person.avatar || '🎉' %></div>
      <% if (person.badge) { %><span class="person-badge"><%= person.badge %></span><% } %>
      <h1>Hey <%= person.name %>!</h1>
      <% if (person.customMessage) { %><p class="custom-message"><%= person.customMessage %></p><% } %>
      <% if (person.poems && person.poems.length > 0) { %>
      <div class="section-box poetry-box">
        <div class="section-header" style="justify-content:center"><span class="section-icon">✨</span><h3>A little verse for you</h3></div>
        <div class="poetry-line" id="poetry-line"><%= person.poems[0] %></div>
        <div class="poetry-dots" id="poetry-dots">
          <% person.poems.forEach(function(p, i) { %>
            <span class="poetry-dot <%= i === 0 ? 'active' : '' %>" data-idx="<%= i %>"></span>
          <% }); %>
        </div>
      </div>
      <% } %>

      <% if (person.paradoxes && person.paradoxes.length > 0) { %>
      <div class="section-box paradox-box">
        <div class="section-header" style="justify-content:center"><span class="section-icon">♾️</span><h3>Paradox</h3></div>
        <div class="paradox-text" id="paradox-text"></div>
        <p style="font-size:0.75rem;color:#7c6a9a;margin-top:10px">↻ refresh to generate a new paradox</p>
      </div>
      <% } %>

      <% if (person.id === 'eeshah') { %>
      <div class="miss-button-wrapper">
        <button class="miss-btn" id="miss-btn" onclick="openMissModal()">Press Only When You Miss Me 💌</button>
      </div>
      <span class="mind-counter" id="mind-counter" onclick="incrementMind()" title="click to count">84,321</span>
      <% } %>

      <p class="subtitle">Here are your class memories</p>
      <span class="visit-counter">✨ Visited <strong><%= person.visits || 0 %></strong> times</span>
    </header>

    <% if (showGeneral) { %>
    <!-- ─── TABS ─── -->
    <div class="tabs-container animate-fade-up">
      <div class="tabs-nav">
        <button class="tab-btn active" data-tab="general">General 🚀</button>
        <button class="tab-btn" data-tab="namaz">Namaz 🕌</button>
      </div>

      <!-- TAB: GENERAL -->
      <div class="tab-content active" id="tab-general">
        <div class="roadmap-section">
          <h2 class="roadmap-title">7-Week AI & Vibe-Coding Plan 🧠</h2>
          <div class="roadmap-timeline">
            <div class="roadmap-item">
              <div class="roadmap-dot"></div>
              <div class="roadmap-content">
                <span class="roadmap-date">Week 1</span>
                <div class="roadmap-heading-row"><input type="checkbox" class="progress-check" data-key="progress-<%= person.id %>-week1"><h3 class="roadmap-heading">Python Basics Crash Course</h3></div>
                <p class="roadmap-desc">Variables, loops, functions, and file I/O. Code along with a short YouTube playlist. <% if (gu.week1) { %><a href="<%= gu.week1 %>" target="_blank" class="url-link">🔗 Link</a><% } else { %><a href="#" class="url-placeholder">[Add URL in Admin]</a><% } %></p>
              </div>
            </div>
            <div class="roadmap-item">
              <div class="roadmap-dot"></div>
              <div class="roadmap-content">
                <span class="roadmap-date">Week 2</span>
                <div class="roadmap-heading-row"><input type="checkbox" class="progress-check" data-key="progress-<%= person.id %>-week2"><h3 class="roadmap-heading">How AI APIs Work</h3></div>
                <p class="roadmap-desc">OpenAI, Claude, Gemini APIs. Make your first API call. <% if (gu.week2) { %><a href="<%= gu.week2 %>" target="_blank" class="url-link">🔗 Link</a><% } else { %><a href="#" class="url-placeholder">[Add URL in Admin]</a><% } %></p>
              </div>
            </div>
            <div class="roadmap-item">
              <div class="roadmap-dot"></div>
              <div class="roadmap-content">
                <span class="roadmap-date">Week 3</span>
                <div class="roadmap-heading-row"><input type="checkbox" class="progress-check" data-key="progress-<%= person.id %>-week3"><h3 class="roadmap-heading">Vibe Coding with Cursor &amp; Claude</h3></div>
                <p class="roadmap-desc">Learn to prompt-code. Build a small app using natural language. <% if (gu.week3) { %><a href="<%= gu.week3 %>" target="_blank" class="url-link">🔗 Link</a><% } else { %><a href="#" class="url-placeholder">[Add URL in Admin]</a><% } %></p>
              </div>
            </div>
            <div class="roadmap-item">
              <div class="roadmap-dot"></div>
              <div class="roadmap-content">
                <span class="roadmap-date">Week 4</span>
                <div class="roadmap-heading-row"><input type="checkbox" class="progress-check" data-key="progress-<%= person.id %>-week4"><h3 class="roadmap-heading">Build a Real Project (AI-assisted)</h3></div>
                <p class="roadmap-desc">Todo app, blog, or portfolio — use AI to generate and iterate. <% if (gu.week4) { %><a href="<%= gu.week4 %>" target="_blank" class="url-link">🔗 Link</a><% } else { %><a href="#" class="url-placeholder">[Add URL in Admin]</a><% } %></p>
              </div>
            </div>
            <div class="roadmap-item">
              <div class="roadmap-dot"></div>
              <div class="roadmap-content">
                <span class="roadmap-date">Week 5</span>
                <div class="roadmap-heading-row"><input type="checkbox" class="progress-check" data-key="progress-<%= person.id %>-week5"><h3 class="roadmap-heading">HTML/CSS + v0.dev UI</h3></div>
                <p class="roadmap-desc">Design beautiful UIs with AI-powered tools like v0.dev. <% if (gu.week5) { %><a href="<%= gu.week5 %>" target="_blank" class="url-link">🔗 Link</a><% } else { %><a href="#" class="url-placeholder">[Add URL in Admin]</a><% } %></p>
              </div>
            </div>
            <div class="roadmap-item">
              <div class="roadmap-dot"></div>
              <div class="roadmap-content">
                <span class="roadmap-date">Week 6</span>
                <div class="roadmap-heading-row"><input type="checkbox" class="progress-check" data-key="progress-<%= person.id %>-week6"><h3 class="roadmap-heading">Deploy it Live</h3></div>
                <p class="roadmap-desc">Vercel, Netlify, or HuggingFace Spaces. Ship your project. <% if (gu.week6) { %><a href="<%= gu.week6 %>" target="_blank" class="url-link">🔗 Link</a><% } else { %><a href="#" class="url-placeholder">[Add URL in Admin]</a><% } %></p>
              </div>
            </div>
            <div class="roadmap-item">
              <div class="roadmap-dot"></div>
              <div class="roadmap-content">
                <span class="roadmap-date">Week 7</span>
                <div class="roadmap-heading-row"><input type="checkbox" class="progress-check" data-key="progress-<%= person.id %>-week7"><h3 class="roadmap-heading">Polish, Portfolio, Next Steps</h3></div>
                <p class="roadmap-desc">Add a README, clean up code, share it with friends. Plan what to build next. <% if (gu.week7) { %><a href="<%= gu.week7 %>" target="_blank" class="url-link">🔗 Link</a><% } else { %><a href="#" class="url-placeholder">[Add URL in Admin]</a><% } %></p>
              </div>
            </div>
          </div>
        </div>

        <div class="roadmap-section">
          <h2 class="roadmap-title">9 AI Skills to Master in 2026 🔥</h2>
          <div class="ai-skills-grid">
            <% var skills = [
              {n:1, t:'Prompt Engineering', d:'ChatGPT, Claude, Gemini', k:'skill1'},
              {n:2, t:'AI Workflow Automation', d:'Zapier, Make, n8n', k:'skill2'},
              {n:3, t:'AI Agents', d:'Crew AI, LangGraph, AutoGen', k:'skill3'},
              {n:4, t:'RAG (Retrieval-Augmented Gen)', d:'LangChain, Vectara, LlamaIndex', k:'skill4'},
              {n:5, t:'Fine-Tuning & Custom GPTs', d:'OpenAI GPT Builder, Hugging Face, Cohere', k:'skill5'},
              {n:6, t:'Multimodal AI', d:'GPT-4, Gemini, Grok', k:'skill6'},
              {n:7, t:'AI Video Generation', d:'Runway, OpusClip, Pika', k:'skill7'},
              {n:8, t:'AI Tool Stacking', d:'Notion, ClickUp, Zapier', k:'skill8'},
              {n:9, t:'LLM Evaluation & Management', d:'Helicone, PromptLayer, TruLens', k:'skill9'}
            ]; %>
            <% skills.forEach(function(s) { %>
            <div class="ai-skill-card">
              <div class="ai-skill-num"><%= s.n %></div>
              <h3><%= s.t %></h3>
              <p><%= s.d %></p>
              <div style="display:flex;align-items:center;gap:6px;margin-top:6px"><input type="checkbox" class="progress-check" data-key="progress-<%= person.id %>-<%= s.k %>"><span style="font-size:0.75rem;color:#888">done</span><% if (gu[s.k]) { %><a href="<%= gu[s.k] %>" target="_blank" class="url-link">🔗 Link</a><% } else { %><a href="#" class="url-placeholder">[Add URL in Admin]</a><% } %></div>
            </div>
            <% }); %>
          </div>
        </div>
      </div>

      <!-- TAB: NAMAZ -->
      <div class="tab-content" id="tab-namaz">
        <div class="roadmap-section">
          <h2 class="roadmap-title">Keep Your Namaz Up to Date 🕌</h2>
          <p class="namaz-subtitle">Track your 5 daily prayers. Consistency over perfection.</p>

          <div class="namaz-stats-row">
            <div class="namaz-stat-card">
              <span class="namaz-stat-value" id="today-progress">0%</span>
              <span class="namaz-stat-label">Today</span>
            </div>
            <div class="namaz-stat-card">
              <span class="namaz-stat-value" id="streak-count">0</span>
              <span class="namaz-stat-label">Day Streak</span>
            </div>
            <div class="namaz-stat-card">
              <span class="namaz-stat-value" id="total-prayers">0</span>
              <span class="namaz-stat-label">Total Prayers</span>
            </div>
          </div>

          <div class="namaz-prayer-grid" id="namaz-prayer-grid">
            <div class="namaz-prayer-card" data-prayer="Fajr">
              <span class="prayer-name">Fajr</span>
              <span class="prayer-time">Before sunrise</span>
              <button class="prayer-check" data-prayer="Fajr">✓</button>
            </div>
            <div class="namaz-prayer-card" data-prayer="Dhuhr">
              <span class="prayer-name">Dhuhr</span>
              <span class="prayer-time">Midday</span>
              <button class="prayer-check" data-prayer="Dhuhr">✓</button>
            </div>
            <div class="namaz-prayer-card" data-prayer="Asr">
              <span class="prayer-name">Asr</span>
              <span class="prayer-time">Afternoon</span>
              <button class="prayer-check" data-prayer="Asr">✓</button>
            </div>
            <div class="namaz-prayer-card" data-prayer="Maghrib">
              <span class="prayer-name">Maghrib</span>
              <span class="prayer-time">Sunset</span>
              <button class="prayer-check" data-prayer="Maghrib">✓</button>
            </div>
            <div class="namaz-prayer-card" data-prayer="Isha">
              <span class="prayer-name">Isha</span>
              <span class="prayer-time">Night</span>
              <button class="prayer-check" data-prayer="Isha">✓</button>
            </div>
          </div>

          <div class="namaz-week-history">
            <h3>Last 7 Days</h3>
            <div class="week-grid" id="week-grid"></div>
          </div>
        </div>
      </div>
    </div>
    <% } else { %>
    <!-- ─── NAMAZ ONLY (no general for muaaz/moazam) ─── -->
    <div class="tabs-container animate-fade-up">
      <div class="namaz-section-standalone">
        <div class="roadmap-section">
          <h2 class="roadmap-title">Keep Your Namaz Up to Date 🕌</h2>
          <p class="namaz-subtitle">Track your 5 daily prayers. Consistency over perfection.</p>

          <div class="namaz-stats-row">
            <div class="namaz-stat-card">
              <span class="namaz-stat-value" id="today-progress">0%</span>
              <span class="namaz-stat-label">Today</span>
            </div>
            <div class="namaz-stat-card">
              <span class="namaz-stat-value" id="streak-count">0</span>
              <span class="namaz-stat-label">Day Streak</span>
            </div>
            <div class="namaz-stat-card">
              <span class="namaz-stat-value" id="total-prayers">0</span>
              <span class="namaz-stat-label">Total Prayers</span>
            </div>
          </div>

          <div class="namaz-prayer-grid" id="namaz-prayer-grid">
            <div class="namaz-prayer-card" data-prayer="Fajr">
              <span class="prayer-name">Fajr</span>
              <span class="prayer-time">Before sunrise</span>
              <button class="prayer-check" data-prayer="Fajr">✓</button>
            </div>
            <div class="namaz-prayer-card" data-prayer="Dhuhr">
              <span class="prayer-name">Dhuhr</span>
              <span class="prayer-time">Midday</span>
              <button class="prayer-check" data-prayer="Dhuhr">✓</button>
            </div>
            <div class="namaz-prayer-card" data-prayer="Asr">
              <span class="prayer-name">Asr</span>
              <span class="prayer-time">Afternoon</span>
              <button class="prayer-check" data-prayer="Asr">✓</button>
            </div>
            <div class="namaz-prayer-card" data-prayer="Maghrib">
              <span class="prayer-name">Maghrib</span>
              <span class="prayer-time">Sunset</span>
              <button class="prayer-check" data-prayer="Maghrib">✓</button>
            </div>
            <div class="namaz-prayer-card" data-prayer="Isha">
              <span class="prayer-name">Isha</span>
              <span class="prayer-time">Night</span>
              <button class="prayer-check" data-prayer="Isha">✓</button>
            </div>
          </div>

          <div class="namaz-week-history">
            <h3>Last 7 Days</h3>
            <div class="week-grid" id="week-grid"></div>
          </div>
        </div>
      </div>
    </div>
    <% } %>

    <% if (person.id === 'eeshah') { %>
    <div class="sky-section" id="sky-section">
      <div class="sky-canvas" id="sky-canvas"></div>
      <div class="sky-message"><span class="sky-label" id="sky-label"></span> Wherever you are, I hope you looked at this sky today too.</div>
    </div>

      <div class="section-box chat-glimpse-box animate-fade-up">
        <div class="section-header">
          <span class="section-icon">💬</span>
          <h3>Our whole chat in one glimpse</h3>
          <span class="item-count">1</span>
        </div>
        <div class="chat-glimpse-preview">
          <p>Every message, every moment — our story in full</p>
          <a href="/cards/whole_chat.html" target="_blank" class="btn">View Card</a>
        </div>
      </div>
    <% } %>

    <% if (person.id === 'muneeba') { %>
      <div class="section-box chat-glimpse-box animate-fade-up">
        <div class="section-header">
          <span class="section-icon">💬</span>
          <h3>Our whole chat in one glimpse</h3>
          <span class="item-count">1</span>
        </div>
        <div class="chat-glimpse-preview">
          <p>Every message, every moment — our story in full</p>
          <a href="/cards/muneeba_chat.html" target="_blank" class="btn">View Card</a>
        </div>
      </div>
    <% } %>

    <% if (typeof hasCard !== 'undefined' && hasCard) { %>
      <div class="section-box farewell-card-box animate-fade-up">
        <div class="section-header">
          <span class="section-icon">💌</span>
          <h3>Farewell Card</h3>
          <span class="item-count">1</span>
        </div>
        <div class="farewell-card-preview">
          <p>A farewell letter for you</p>
          <a href="/cards/<%= person.id %>.html" target="_blank" class="btn">View Card</a>
        </div>
      </div>
    <% } %>

    <div class="section-box animate-fade-up" style="border-color:rgba(102,126,234,0.2)">
      <div class="section-header">
        <span class="section-icon">👥</span>
        <h3>Our Class Memory Book</h3>
        <span class="item-count">shared</span>
      </div>
      <div class="chat-glimpse-preview">
        <p>A shared card for all 8 of us — together forever 💙</p>
        <a href="/cards/group.html" target="_blank" class="btn">Open Group Card</a>
      </div>
    </div>

    <% if (person.playlist && person.playlist.length > 0) { %>
    <div class="section-box playlist-box animate-fade-up">
      <div class="section-header">
        <span class="section-icon">🎵</span>
        <h3>A playlist specially for you</h3>
        <span class="item-count"><%= person.playlist.length %></span>
      </div>
      <div class="playlist-items">
        <% person.playlist.forEach(function(song) { %>
          <a href="<%= song.url %>" target="_blank" class="playlist-item">
            <span class="playlist-play">▶</span>
            <span class="playlist-title"><%= song.title %></span>
            <span class="playlist-link">Listen →</span>
          </a>
        <% }); %>
      </div>
    </div>
    <% } %>

    <% if (typeof hasFiles !== 'undefined' && hasFiles) { %>
    <div style="text-align:center;margin-bottom:24px">
      <a href="/api/person/<%= person.id %>/download" class="btn" style="background:linear-gradient(135deg,#4caf50,#2e7d32)" onclick="this.textContent='Preparing...'">📦 Download All My Files</a>
    </div>
    <% } %>

    <div class="sections">
      <% if (person.sections.length === 0 && (!person.roadmap || person.roadmap.length === 0)) { %>
        <% if (typeof hasCard === 'undefined' || !hasCard) { %>
        <div class="empty-state">
          <p>Nothing here yet. Check back later!</p>
        </div>
        <% } %>
      <% } %>

      <% person.sections.forEach(function(section, secIdx) { %>
        <div class="section-box animate-fade-up" style="animation-delay: <%= 0.1 + secIdx * 0.1 %>s">
          <div class="section-header">
            <span class="section-icon"><%= {voice: '🎤', images: '🖼️', videos: '🎬', texts: '📝', other: '📦'}[section.type] || '📦' %></span>
            <h3><%= section.title %></h3>
            <span class="item-count"><%= section.items.length %></span>
          </div>

          <% if (section.items.length === 0) { %>
            <p class="empty-note">No items yet</p>
          <% } %>

          <div class="items-grid <%= section.type === 'images' ? 'items-masonry' : '' %>">
            <% section.items.forEach(function(item) { %>
              <% var now = new Date(); %>
              <% var release = new Date(item.releaseDate + 'T23:59:59'); %>
              <% var isUnlocked = now >= release; %>
              <% var isExternal = item.filename.indexOf('http') === 0; %>
              <% var fileUrl = isExternal ? item.filename : '/uploads/' + person.id + '/' + section.id + '/' + item.filename; %>
              <% var cleanName = item.filename.split('?')[0].split('/').pop(); %>
              <% var isImage = /\.(jpg|jpeg|png|gif|webp)$/i.test(cleanName); %>
              <% var isVideo = /\.(mp4|webm|mov)$/i.test(cleanName); %>
              <% var isAudio = /\.(mp3|wav|ogg|m4a)$/i.test(cleanName); %>

              <div class="item-card <%= isUnlocked ? 'unlocked' : 'locked' %> <%= isImage ? 'item-image' : '' %>">
                <% if (isUnlocked) { %>
                  <div class="item-preview">
                    <% if (isImage) { %>
                      <img src="<%= fileUrl %>" alt="<%= item.title %>" loading="lazy" style="height:auto; min-height:100px">
                    <% } else if (isVideo) { %>
                      <video controls preload="metadata">
                        <source src="<%= fileUrl %>">
                      </video>
                    <% } else if (isAudio) { %>
                      <audio controls preload="metadata">
                        <source src="<%= fileUrl %>">
                      </audio>
                    <% } else { %>
                      <div class="file-icon">
                        <a href="<%= fileUrl %>" download><%= item.originalName %></a>
                      </div>
                    <% } %>
                  </div>
                  <div class="item-info">
                    <span class="item-title"><%= item.title %></span>
                    <button class="reaction-btn" data-key="<%= person.id %>-<%= section.id %>-<%= item.filename.replace(/[^a-zA-Z0-9]/g,'') %>" onclick="toggleReaction(this)">🤍 <span class="reaction-count">0</span></button>
                  </div>
                <% } else { %>
                  <div class="lock-overlay">
                    <div class="lock-icon">🔒</div>
                    <div class="lock-text">
                      <p>Available on</p>
                      <p class="release-date"><%= new Date(item.releaseDate).toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></p>
                    </div>
                    <% var daysUntil = Math.ceil((release - now) / (1000 * 60 * 60 * 24)); %>
                    <% if (daysUntil > 0) { %>
                      <p class="days-left"><%= daysUntil %> day<%= daysUntil > 1 ? 's' : '' %> left</p>
                    <% } %>
                  </div>
                <% } %>
              </div>
            <% }); %>
          </div>
        </div>
      <% }); %>
    </div>

